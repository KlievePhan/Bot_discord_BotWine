# =====================================================================
# CẤU HÌNH DISCORD MUSIC BOT
# Sao chép file này thành .env (hoặc sửa trực tiếp file .env)
# =====================================================================

# 1. Token của Bot lấy từ https://discord.com/developers/applications
DISCORD_TOKEN=dan_token_bot_cua_ban_vao_day
# 2. Tiền tố lệnh văn bản (ví dụ: !play, !p, !skip)
COMMAND_PREFIX=!

# 3. Đường dẫn file cookies YouTube (tùy chọn - tự động kích hoạt nếu file tồn tại)
COOKIES_FILE=cookies.txt

# 4. Đường dẫn FFmpeg (để trống bot sẽ tự động tìm trên máy / Winget)
FFMPEG_PATH=

# 5. Tự động rời phòng thoại (tính bằng giây)
# - Khi phát hết nhạc và không ai thêm bài mới (mặc định 180s = 3 phút)
AUTO_LEAVE_IDLE_SECONDS=180
# - Khi mọi người rời hết khỏi phòng thoại, chỉ còn mình bot (mặc định 60s)
AUTO_LEAVE_EMPTY_SECONDS=60

# 6. Âm lượng mặc định khi mới vào phòng (1 - 200, mặc định 80)
DEFAULT_VOLUME=80
